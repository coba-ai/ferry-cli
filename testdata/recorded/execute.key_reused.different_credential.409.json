{
  "scenario": "execute.key_reused.different_credential.409",
  "expect": [
    {
      "status": 409,
      "code": "IDEMPOTENCY_KEY_REUSED",
      "headers_present": [
        "Ferry-Command-Id"
      ],
      "headers_absent": [],
      "body_has": [
        "error.details.command_id"
      ],
      "body_lacks": [],
      "body_equals": {
        "error.details.reason": "different_credential"
      }
    }
  ],
  "interactions": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/transfers",
        "headers": {
          "idempotency_key_present": true,
          "credential_class": "api_key",
          "content_type": "application/json"
        },
        "body": {
          "plan_token": "ferry_plan_PLACEHOLDER"
        }
      },
      "response": {
        "status": 409,
        "headers": {
          "Ferry-Command-Id": "cmd_PLACEHOLDER_1",
          "Idempotency-Key": "IDEMPOTENCY_KEY_PLACEHOLDER_1",
          "Ferry-Environment": "sandbox",
          "Content-Type": "application/json; charset=utf-8"
        },
        "body": {
          "error": {
            "code": "IDEMPOTENCY_KEY_REUSED",
            "message": "This Idempotency-Key was used for a different request.",
            "retriable": false,
            "retry_after_seconds": null,
            "details": {
              "reason": "different_credential",
              "command_id": "cmd_PLACEHOLDER_1"
            },
            "request_id": "UUID_PLACEHOLDER_1",
            "docs_url": "https://docs.ferry.example/errors/IDEMPOTENCY_KEY_REUSED"
          }
        }
      }
    }
  ]
}
