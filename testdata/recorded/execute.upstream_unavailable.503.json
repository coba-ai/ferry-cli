{
  "scenario": "execute.upstream_unavailable.503",
  "expect": [
    {
      "status": 503,
      "code": "UPSTREAM_UNAVAILABLE",
      "headers_present": [
        "Ferry-Command-Id",
        "Idempotency-Replayed"
      ],
      "headers_absent": [],
      "body_has": [],
      "body_lacks": [],
      "body_equals": {}
    }
  ],
  "interactions": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/transfers",
        "headers": {
          "idempotency_key_present": true,
          "credential_class": "api_key",
          "content_type": "application/json"
        },
        "body": {
          "plan_token": "ferry_plan_PLACEHOLDER"
        }
      },
      "response": {
        "status": 503,
        "headers": {
          "Ferry-Command-Id": "cmd_PLACEHOLDER_1",
