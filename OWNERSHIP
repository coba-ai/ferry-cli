# The machine-readable form of PLAN §4.1.
#
# Every file under cli/ matches exactly one prefix here, and every prefix
# names a unit of §4.1. cli/ownership_test.go (AC84) enforces both in every
# `go test ./...`, so a file that belongs to nobody fails the wave that added
# it rather than U7's audit five waves later.
#
# Paths are relative to cli/. A trailing slash owns everything beneath it; a
# path without one is exactly that file. Prefixes must not overlap: "exactly
# one" is the property, because two owners is the same coordination failure as
# none.
#
# Adding a prefix is an amendment (§11.1) unless you are the unit §4.1 gives
# the path to.

units:
  U0:
    description: Recorded interactions (Ruby)
    paths:
      - testdata/recorded/

  U1:
    description: Go module, local state, harness, ownership lint
    paths:
      - go.mod
      - go.sum
      - OWNERSHIP
      - ownership_test.go
      - contract_test.go
      # A418: OWNERSHIP's ignored list below claimed dist/ and the built
      # binary were gitignored in a repository with no .gitignore, so both
      # live here beside the list that makes the claim — the test joins the
      # two, and a claim and its check drifting apart is what it exists to
      # stop.
      - .gitignore
      - gitignore_test.go
      # A400 split the CLI into its own repository. contract/ is the vendored
      # copy of the API's openapi.yaml and errors.md that the pins in
      # internal/api and internal/outcome read, and docs/PLAN.md is this
      # plan, which moved with the code. They are repository scaffolding, so
      # they sit with the rest of it.
      - contract/
      # A370: docs/ was a subtree here until U7 needed to put two documents
      # of its own in it. Prefixes must not overlap, so a subtree prefix
      # cannot be shared — the two files are named below and U7 names its
      # two. The cost is that a new document under docs/ is unowned until
      # somebody assigns it, which is the lint doing its job rather than a
      # regression: §4.1 gives docs/ to no unit collectively.
      - docs/PLAN.md
      - docs/CRITIQUE.md
      - internal/version/
      - internal/ulid/
      - internal/xdg/
      - internal/creds/
      - internal/runs/
      - internal/fsx/
      - internal/harness/

  U2:
    description: API client and decision table
    paths:
      - internal/api/
      - internal/outcome/

  U3:
    description: Fixture server
    paths:
      - internal/fixture/

  U4:
    description: Auth, keys, corridors, rendering, pre-check
    paths:
      - internal/render/
      - internal/noun/auth/
      - internal/noun/keys/
      - internal/noun/corridors/
      - internal/noun/precheck.go
      - internal/noun/precheck_test.go

  U5:
    description: Money path, polling, runs, consent, root
    paths:
      - cmd/ferry/main.go
      - internal/cli/
      - internal/poll/
      - internal/noun/transfers/
      - internal/noun/commandq/
      - internal/noun/runs/
      - internal/consent/
      - internal/fault/

  U6:
    description: CI, e2e, release
    paths:
      - .goreleaser.yaml
      - e2e/
      - README.md
      # A400: the workflow arrives with the split rather than with U6,
      # for the reason A315 gave — a CI job that lands after the code it
      # checks has not checked it. U6 extends it with goreleaser.
      - .github/

  U7:
    description: Adversarial matrix, audit, documentation
    paths:
      - internal/adversarial_test.go
      # A400 moved these out of the API repository's docs/loops/cli/, which
      # A401 deleted in favour of a README pointing here. AC68's audit and
      # AC89's still-present-defect list are U7's own record.
      - docs/MUTATIONS.md
      - docs/DOC-DEFECTS.md

  # U8 owns only Ruby files, outside cli/. It is listed so the test can check
  # the unit names here against §4.1 in both directions.
  U8:
    description: Contract schemas (Ruby) — owns no path under cli/
    paths: []

# Paths that are not source and belong to no unit. Each needs a reason: an
# ignore list without one is how a file quietly stops being owned. These are
# paths, not gitignore patterns — .gitignore holds the patterns, and
# gitignore_test.go checks that git actually ignores every path named here.
ignored:
  - path: dist/
    reason: goreleaser's build output (.goreleaser.yaml, U6); gitignored, never committed.
  - path: ferry
    reason: >
      the binary a local `go build` drops in the module root. .gitignore
      anchors its pattern to `/ferry`, because an unanchored one also matches
      cmd/ferry/ and would ignore the source that builds it.
  - path: ferry-fault
    reason: the faultinject build, which e2e/run.sh names and a local run may too.
